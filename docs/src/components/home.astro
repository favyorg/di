---
const installCommand = 'npm install @favy/di';
const quickStart = [
  "import { Module, type Live } from '@favy/di';",
  '',
  "const Clock = Module()('Clock', () => ({",
  '  now: () => new Date(),',
  '}));',
  'type ClockLive = Live<typeof Clock>;',
  '',
  'const Greeting = Module<ClockLive>()(',
  "  'Greeting',",
  '  ({ Clock }) => ({',
  "    message: () => 'Hello at ' + Clock.now().toISOString(),",
  '  }),',
  ');',
  '',
  'Greeting({ Clock }).message();',
].join('\n');

const proofPoints = [
  { value: '0', label: 'decorators' },
  { value: 'Typed', label: 'end to end' },
  { value: 'Lazy', label: 'by default' },
  { value: 'Replaceable', label: 'boundaries' },
];

const steps = [
  {
    number: '01',
    title: 'Define',
    copy: 'A module is a named function with a typed input and output.',
  },
  {
    number: '02',
    title: 'Compose',
    copy: "ClockLive names Clock's output for reuse as a typed dependency.",
  },
  {
    number: '03',
    title: 'Run',
    copy: 'Supply implementations at the boundary and call the resulting graph.',
  },
];

const capabilities = [
  {
    label: 'Graph',
    title: 'Dependencies stay explicit',
    copy: 'Read the contract at the function boundary. TypeScript verifies every connection.',
    links: [{ href: '/module/module/', label: 'Module model' }],
  },
  {
    label: 'Lifetime',
    title: 'Cache on your terms',
    copy: 'Choose run, module, or no caching without changing the consumer.',
    links: [{ href: '/module/cache/', label: 'Caching' }],
  },
  {
    label: 'Resolution',
    title: 'Initialize only when used',
    copy: 'Dependencies resolve lazily by default, including deep inside the graph.',
    links: [{ href: '/module/lazy/', label: 'Lazy initialization' }],
  },
  {
    label: 'Composition',
    title: 'Preconfigure a boundary',
    copy: 'Provide part of a graph once, then expose only what the caller should supply.',
    links: [{ href: '/module/partial/', label: 'Partial application' }],
  },
  {
    label: 'Testing',
    title: 'Replace values, not machinery',
    copy: 'Pass a small fake at the same typed boundary—there is no container to reset.',
    links: [{ href: '/guides/testing/', label: 'Testing guide' }],
  },
  {
    label: 'Advanced',
    title: 'Shape the edges',
    copy: 'Transform input and output while preserving inference through the graph.',
    links: [
      { href: '/module/transform-input/', label: 'Input' },
      { href: '/module/transform-output/', label: 'Output' },
    ],
  },
];

const paths = [
  {
    number: '01',
    title: 'Start',
    copy: 'Build the first graph and learn the core mental model.',
    links: [
      { href: '/guides/introduction/', label: 'Introduction' },
      { href: '/module/module/', label: 'Module' },
    ],
  },
  {
    number: '02',
    title: 'Build',
    copy: 'Control when dependencies resolve and how long values live.',
    links: [
      { href: '/module/cache/', label: 'Caching' },
      { href: '/module/lazy/', label: 'Lazy' },
      { href: '/module/partial/', label: 'Partial' },
    ],
  },
  {
    number: '03',
    title: 'Test',
    copy: 'Design replaceable boundaries and keep each test isolated.',
    links: [
      { href: '/guides/testing/', label: 'Testing' },
      { href: '/guides/best-practices/', label: 'Best practices' },
    ],
  },
  {
    number: '04',
    title: 'Extend',
    copy: 'Use transformations and exact signatures when the graph gets advanced.',
    links: [
      { href: '/module/transform-input/', label: 'Transform input' },
      { href: '/module/transform-output/', label: 'Transform output' },
      { href: '/reference/api/', label: 'API reference' },
    ],
  },
];
---

<div class="home not-content">
  <div class="home-workbench">
    <div class="workbench-grid">
      <div class="hero-copy">
        <p class="eyebrow">
          <span aria-hidden="true"></span>v3 · TypeScript-first DI
        </p>
        <div class="hero-title" aria-hidden="true">
          Dependency graphs, just typed functions.
        </div>
        <p class="hero-lede">
          Explicit dependencies. Replaceable boundaries. No decorators,
          reflection, or container ceremony.
        </p>

        <div class="hero-actions">
          <a class="button button-primary" href="/guides/introduction/">
            Get started <span aria-hidden="true">→</span>
          </a>
          <a class="button button-secondary" href="/reference/api/">
            API reference
          </a>
        </div>

        <div class="install-row" aria-label="Install @favy/di">
          <span class="terminal-mark" aria-hidden="true">$</span>
          <code>{installCommand}</code>
          <button
            class="copy-button"
            type="button"
            data-copy
            data-copy-state="idle"
            data-copy-value={installCommand}
            aria-label="Copy install command"
            data-copy-success-label="Install command copied"
            data-copy-error-label="Could not copy install command"
            hidden
          >
            <svg aria-hidden="true" viewBox="0 0 20 20">
              <rect x="7" y="7" width="9" height="9" rx="2"></rect>
              <path d="M13 7V5a2 2 0 0 0-2-2H5a2 2 0 0 0-2 2v6a2 2 0 0 0 2 2h2"
              ></path>
            </svg>
            <span data-copy-label aria-live="polite">Copy</span>
          </button>
        </div>
      </div>

      <div class="demo-panel">
        <div class="panel-bar">
          <div class="window-dots" aria-hidden="true">
            <span></span><span></span><span></span>
          </div>
          <span class="panel-file">greeting.ts</span>
          <button
            class="copy-button code-copy"
            type="button"
            data-copy
            data-copy-state="idle"
            data-copy-value={quickStart}
            aria-label="Copy quick start code"
            data-copy-success-label="Quick start code copied"
            data-copy-error-label="Could not copy quick start code"
            hidden
          >
            <svg aria-hidden="true" viewBox="0 0 20 20">
              <rect x="7" y="7" width="9" height="9" rx="2"></rect>
              <path d="M13 7V5a2 2 0 0 0-2-2H5a2 2 0 0 0-2 2v6a2 2 0 0 0 2 2h2"
              ></path>
            </svg>
            <span data-copy-label aria-live="polite">Copy</span>
          </button>
        </div>

        <pre
          class="code-block"
          tabindex="0"
          aria-label="TypeScript quick start"><code><span class="code-line"><span class="token-keyword">import</span> &#123; <span class="token-type">Module</span>, <span class="token-keyword">type</span> <span class="token-type">Live</span> &#125; <span class="token-keyword">from</span> <span class="token-string">'@favy/di'</span>;</span>
<span class="code-line" />
<span class="code-line"><span class="token-keyword">const</span> <span class="token-name">Clock</span> = <span class="token-call">Module</span>()(<span class="token-string">'Clock'</span>, () =&gt; (&#123;</span>
<span class="code-line">  <span class="token-property">now</span>: () =&gt; <span class="token-keyword">new</span> <span class="token-call">Date</span>(),</span>
<span class="code-line">&#125;));</span>
<span class="code-line"><span class="token-keyword">type</span> <span class="token-type">ClockLive</span> = <span class="token-type">Live</span>&lt;<span class="token-keyword">typeof</span> <span class="token-name">Clock</span>&gt;;</span>
<span class="code-line" />
<span class="code-line"><span class="token-keyword">const</span> <span class="token-name">Greeting</span> = <span class="token-call">Module</span>&lt;<span class="token-type">ClockLive</span>&gt;()(</span>
<span class="code-line">  <span class="token-string">'Greeting'</span>,</span>
<span class="code-line">  (&#123; <span class="token-name">Clock</span> &#125;) =&gt; (&#123;</span>
<span class="code-line">    <span class="token-property">message</span>: () =&gt; <span class="token-string">'Hello at '</span> + <span class="token-name">Clock</span>.<span class="token-call">now</span>().<span class="token-call">toISOString</span>(),</span>
<span class="code-line">  &#125;),</span>
<span class="code-line">);</span>
<span class="code-line" />
<span class="code-line"><span class="token-call">Greeting</span>(&#123; <span class="token-name">Clock</span> &#125;).<span class="token-call">message</span>();</span></code></pre>
        <span class="scroll-hint" aria-hidden="true">Swipe code →</span>

        <div class="graph-panel">
          <div class="module-graph" aria-hidden="true">
            <div class="graph-node">
              <span>module</span>
              <strong>Clock</strong>
            </div>
            <div class="graph-edge">
              <span>provides</span>
              <svg viewBox="0 0 56 12">
                <path d="M1 6h50"></path>
                <path d="m47 2 4 4-4 4"></path>
              </svg>
            </div>
            <div class="graph-node graph-node-accent">
              <span>module</span>
              <strong>Greeting</strong>
            </div>
            <div class="graph-edge">
              <span>returns</span>
              <svg viewBox="0 0 56 12">
                <path d="M1 6h50"></path>
                <path d="m47 2 4 4-4 4"></path>
              </svg>
            </div>
            <div class="graph-node">
              <span>value</span>
              <strong>message()</strong>
            </div>
          </div>
          <p>
            <code>Clock</code> is resolved when <code>Greeting</code> uses it. Types
            verify the connection before the graph runs.
          </p>
        </div>
      </div>
    </div>

    <ul class="proof-strip" aria-label="Library characteristics">
      {
        proofPoints.map(({ value, label }) => (
          <li>
            <strong>{value}</strong>
            <span>{label}</span>
          </li>
        ))
      }
    </ul>
  </div>

  <section class="home-section model-section" aria-labelledby="model-title">
    <div class="section-intro">
      <p class="section-label">One mental model</p>
      <h2 id="model-title">The graph is the configuration.</h2>
      <p>
        Each edge is an ordinary TypeScript contract. Follow it in the code,
        replace it in a test, or preconfigure it for the next caller.
      </p>
      <div class="text-links">
        <a href="/guides/introduction/">Read the introduction <span>→</span></a>
        <a href="/module/module/">Explore Module <span>→</span></a>
      </div>
    </div>

    <ol class="steps">
      {
        steps.map(({ number, title, copy }) => (
          <li>
            <span class="step-number">{number}</span>
            <div>
              <h3>{title}</h3>
              <p>{copy}</p>
            </div>
          </li>
        ))
      }
    </ol>
  </section>

  <section class="home-section" aria-labelledby="capabilities-title">
    <div class="section-heading">
      <div>
        <p class="section-label">Small API, deliberate control</p>
        <h2 id="capabilities-title">Only the machinery your graph needs.</h2>
      </div>
      <p>
        Start with typed functions. Add lifetime and transformation rules at the
        boundary where they matter.
      </p>
    </div>

    <div class="capability-grid">
      {
        capabilities.map(({ label, title, copy, links }) => (
          <article class="capability-card">
            <span class="card-label">{label}</span>
            <h3>{title}</h3>
            <p>{copy}</p>
            <div class="card-links">
              {links.map(({ href, label: linkLabel }) => (
                <a href={href}>
                  {linkLabel} <span aria-hidden="true">→</span>
                </a>
              ))}
            </div>
          </article>
        ))
      }
    </div>
  </section>

  <section class="home-section paths-section" aria-labelledby="paths-title">
    <div class="section-heading">
      <div>
        <p class="section-label">Documentation paths</p>
        <h2 id="paths-title">Go straight to the work at hand.</h2>
      </div>
      <p>
        The core stays small. Pick a path when you need the next layer of
        control.
      </p>
    </div>

    <div class="path-grid">
      {
        paths.map(({ number, title, copy, links }) => (
          <article class="path-card">
            <span class="path-number">{number}</span>
            <div class="path-copy">
              <h3>{title}</h3>
              <p>{copy}</p>
              <div class="path-links">
                {links.map(({ href, label }) => (
                  <a href={href}>{label}</a>
                ))}
              </div>
            </div>
          </article>
        ))
      }
    </div>
  </section>

  <section class="closing-panel" aria-labelledby="closing-title">
    <div>
      <p class="section-label">Build the first edge</p>
      <h2 id="closing-title">
        Start with one module. Grow when the graph does.
      </h2>
    </div>
    <div class="closing-actions">
      <a class="button button-primary" href="/guides/introduction/">
        Get started <span aria-hidden="true">→</span>
      </a>
      <a class="button closing-secondary" href="https://github.com/favyorg/di">
        View on GitHub
      </a>
    </div>
  </section>
</div>

<script>
  const copyTimers = new WeakMap<HTMLButtonElement, number>();

  for (const button of document.querySelectorAll<HTMLButtonElement>(
    '.home [data-copy]',
  )) {
    button.hidden = false;
    button.dataset.copyDefaultLabel =
      button.getAttribute('aria-label') ?? 'Copy';

    button.addEventListener('click', async () => {
      const value = button.dataset.copyValue;
      const label = button.querySelector<HTMLElement>('[data-copy-label]');

      if (!value || !label) return;

      const previousTimer = copyTimers.get(button);
      if (previousTimer) window.clearTimeout(previousTimer);

      try {
        await navigator.clipboard.writeText(value);
        button.dataset.copyState = 'copied';
        button.setAttribute(
          'aria-label',
          button.dataset.copySuccessLabel ?? 'Copied',
        );
        label.textContent = 'Copied';
      } catch {
        button.dataset.copyState = 'error';
        button.setAttribute(
          'aria-label',
          button.dataset.copyErrorLabel ?? 'Copy failed',
        );
        label.textContent = 'Copy failed';
      }

      copyTimers.set(
        button,
        window.setTimeout(() => {
          button.dataset.copyState = 'idle';
          button.setAttribute(
            'aria-label',
            button.dataset.copyDefaultLabel ?? 'Copy',
          );
          label.textContent = 'Copy';
        }, 1800),
      );
    });
  }
</script>

<style>
