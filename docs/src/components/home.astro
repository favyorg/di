    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    clip-path: inset(50%);
    white-space: nowrap;
  }

  :global(html[data-has-hero] .hero h1) {
    position: absolute;
    inset: 0;
    margin: 0;
  }

